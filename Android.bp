genrule {
    name: "gen_TrichromeChrome6432_arm64",
    defaults: ["7z_genrule_defaults"],
    srcs: ["prebuilt/arm64_TrichromeChrome6432.apk.*"],
    out: ["TrichromeChrome6432.apk"],
}

genrule {
    name: "gen_TrichromeChrome6432_x86_64",
    defaults: ["7z_genrule_defaults"],
    srcs: ["prebuilt/x86_64_TrichromeChrome6432.apk.*"],
    out: ["TrichromeChrome6432.apk"],
}

genrule {
    name: "gen_TrichromeLibrary6432_arm64",
    defaults: ["7z_genrule_defaults"],
    srcs: ["prebuilt/arm64_TrichromeLibrary6432.apk.*"],
    out: ["TrichromeLibrary6432.apk"],
}

genrule {
    name: "gen_TrichromeLibrary6432_x86_64",
    defaults: ["7z_genrule_defaults"],
    srcs: ["prebuilts/x86_64_TrichromeLibrary6432.apk.*"],
    out: ["TrichromeLibrary6432.apk"],
}

genrule {
    name: "gen_TrichromeWebView6432_arm64",
    defaults: ["7z_genrule_defaults"],
    srcs: ["prebuilts/arm64_TrichromeWebView6432.apk.*"],
    out: ["TrichromeWebView6432.apk"],
}

genrule {
    name: "gen_TrichromeWebView6432_x86_64",
    defaults: ["7z_genrule_defaults"],
    srcs: ["prebuilts/x86_64_TrichromeWebView6432.apk.*"],
    out: ["TrichromeWebView6432.apk"],
}

android_app_import {
    name: "TrichromeChrome6432",
    system_ext_specific: true,
    overrides: ["Browser2"],
    preprocessed: true,
    presigned: true,
    arch: {
        arm64: {
            apk: ":gen_TrichromeChrome6432_arm64",
        },
        x86_64: {
            apk: ":gen_TrichromeChrome6432_x86_64",
        },
    },
    dex_preopt: {
        enabled: false,
    },
    required: ["TrichromeLibrary6432"],
    optional_uses_libs: [
        "androidx.window.extensions",
    ],
}

android_app_import {
    name: "TrichromeLibrary6432",
    system_ext_specific: true,
    preprocessed: true,
    presigned: true,
    arch: {
        arm64: {
            apk: ":gen_TrichromeLibrary6432_arm64",
        },
        x86_64: {
            apk: ":gen_TrichromeLibrary6432_x86_64",
        },
    },
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "TrichromeWebView6432",
    system_ext_specific: true,
    overrides: ["webview"],
    preprocessed: true,
    presigned: true,
    arch: {
        arm64: {
            apk: ":gen_TrichromeWebView6432_arm64",
        },
        x86_64: {
            apk: ":gen_TrichromeWebView6432_x86_64",
        },
    },
    dex_preopt: {
        enabled: false,
    },
    required: ["TrichromeLibrary6432"],
    optional_uses_libs: [
        "androidx.window.extensions",
    ],
}
